#!/bin/sh
set -eu

# sandboxd exposes the selected credential mode to the sandbox. Cursor's
# OAuth sentinel must only be present in OAuth mode; otherwise it can mask an
# API key or suppress Cursor's first-run login flow.
case "${SBX_CRED_CURSOR_MODE:-none}" in
  oauth)
    export CURSOR_AUTH_TOKEN=cursor-oat-proxy-managed
    ;;
  *)
    if [ "${CURSOR_AUTH_TOKEN:-}" = cursor-oat-proxy-managed ]; then
      unset CURSOR_AUTH_TOKEN
    fi
    ;;
esac

exec /usr/local/bin/cursor-agent.real "$@"
