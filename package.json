{
  "name": "phi-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "phi": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "doctor": "bun run src/cli.ts doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/app.test.ts test/coordinator-trace.test.ts test/credential-mode.test.ts test/fake-adapter.test.ts test/git.test.ts test/migration.test.ts test/official-adapters.test.ts test/recovery.test.ts test/store.test.ts test/tui.test.tsx test/workspace-confinement.test.ts",
    "spike": "bun run spikes/bun-runtime/spike.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "@anthropic-ai/sdk": "0.120.0",
    "@cursor/sdk": "1.0.28",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex-sdk": "0.149.0",
    "@opentui/core": "0.5.7",
    "@opentui/solid": "0.5.7",
    "solid-js": "1.9.12",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
